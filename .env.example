OPENAI_API_KEY=

# Runtime reasoning LLM. Do not use /coding/paas/v4 here.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_SUMMARY_MODEL=glm-4.6
LLM_THINKING_MODE=disabled
LLM_MAX_OUTPUT_TOKENS=4096
ALLOW_CODING_ENDPOINT_FOR_RUNTIME=false

# Optional dedicated Storyline model. This may point to a different compatible endpoint.
OPENAI_storyline_API_KEY=
OPENAI_storyline_BASE_URL=
OPENAI_storyline_MODEL=

# Embeddings.
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_CACHE_PATH=

# Vision / VLM frame captioning.
VISION_API_KEY=
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_CAPTION_MODEL=

# Video/text correlation agent. Uses a vision-capable model.
LLM_correlation_PROVIDER=zhipu
LLM_correlation_API_KEY=
LLM_correlation_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_correlation_MODEL=glm-4.6V
CORRELATION_TEXT_MIN_CHARS=80
CORRELATION_SAMPLE_FRAMES=6
CORRELATION_LOW_THRESHOLD=0.2
CORRELATION_HIGH_THRESHOLD=0.8

OBSIDIAN_VAULT_PATH=
DATA_DIR=./data

# Runtime behavior.
STRICT_RUNTIME=true
FORCE_REFRESH=false
REQUEST_TIMEOUT_SECONDS=240
PIPELINE_STAGE_RESTART_LIMIT=2
SUMMARY_MAX_SEGMENTS=24
SUMMARY_SEGMENT_CHARS=500
SUMMARY_CAPTION_CHARS=300
SUMMARY_MAP_CONCURRENCY=1
STORYLINE_TOP_K=8
VLM_CAPTION_CONCURRENCY=3
VLM_CAPTION_RETRIES=2
LLM_MAX_CONCURRENCY=1
LLM_MIN_INTERVAL_SECONDS=3.0
VLM_MIN_INTERVAL_SECONDS=2.0
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_MIN_INTERVAL_SECONDS=1.0
YTDLP_MAX_CONCURRENCY=1
YTDLP_MIN_INTERVAL_SECONDS=6.0
ASR_MAX_CONCURRENCY=1
ASR_MIN_INTERVAL_SECONDS=2.0
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=2.0
API_RATE_LIMIT_COOLDOWN_SECONDS=30.0
PIPELINE_RESUME=true
PIPELINE_FORCE_STAGE=
VISUAL_CLASSIFIER_ENABLED=true
VISUAL_STRENGTH_THRESHOLD=0.48
WEAK_VISUAL_FRAME_FPS=0.05
STRONG_VISUAL_FRAME_FPS=1.0
WEAK_VISUAL_MAX_FRAMES_PER_SEGMENT=1
STRONG_VISUAL_MAX_FRAMES_PER_SEGMENT=3

# ASR. Local faster-whisper is default. Cloud providers can be added through this interface.
ASR_PROVIDER=local
ASR_MODEL=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=default
ASR_BEAM_SIZE=1
ASR_VAD_FILTER=true
ASR_API_KEY=
ASR_BASE_URL=

# OCR is disabled in the current stage.
OCR_PROVIDER=none
OCR_ENGINE=none
OCR_LANG=eng
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=

# Vector store. Current stage uses ChromaDB ephemeral in-memory collection.
VECTOR_STORE=memory
CHROMA_PATH=./data/chroma

# yt-dlp optional settings
YTDLP_COOKIES_FILE=
# Reuse browser login cookies directly. Examples: chrome, edge, firefox, chrome:Profile 1
YTDLP_COOKIES_FROM_BROWSER=
# CDN reads are retried and large files are fetched in restartable chunks.
YTDLP_SOCKET_TIMEOUT_SECONDS=60
YTDLP_RETRIES=10
YTDLP_HTTP_CHUNK_BYTES=10485760
YTDLP_MAX_VIDEO_HEIGHT=720

# MemPalace integration. Use mcp_stdio for local MCP over stdin/stdout.
MEMPALACE_PROVIDER=noop
MEMPALACE_ENDPOINT=
MEMPALACE_API_KEY=
MEMPALACE_COMMAND=python
MEMPALACE_ARGS=-m mempalace.mcp_server
MEMPALACE_PALACE_PATH=
MEMPALACE_TIMEOUT_SECONDS=30
MEMPALACE_AUTO_STATUS=true
MEMORY_PROMOTION_ENABLED=true
MEMORY_GATE_MODE=auto
# Optional cheap routing model on the same runtime LLM endpoint; empty reuses the main model.
MEMORY_GATE_MODEL=
MEMORY_GATE_TIMEOUT_SECONDS=20
MEMORY_TOP_K=4
MEMORY_CONTEXT_CHARS=4000
MEMORY_MIN_SIMILARITY=0.35
MEMORY_TOPIC_MODEL_ENABLED=true
